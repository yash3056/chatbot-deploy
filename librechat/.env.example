# Server
HOST=0.0.0.0
PORT=3080

# MongoDB
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=change_this_to_a_long_random_string

# Security — generate your own randoms, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_32
CREDS_KEY=replace_with_32_char_hex
CREDS_IV=replace_with_16_char_hex

# Disable unneeded providers (keeps the UI clean)
ENDPOINTS=custom

# Allow new account
ALLOW_REGISTRATION=true

# Admin Users
ADMIN_EMAIL=xx@gmail.com